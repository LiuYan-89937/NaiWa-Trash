{
  "name": "codex-motion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "check:syntax": "node scripts/check-syntax.mjs",
    "episode:new": "node scripts/new-episode.mjs",
    "tts": "node --env-file-if-exists=.env scripts/tts.mjs",
    "prepare:episode": "node scripts/prepare.mjs",
    "render": "node --env-file-if-exists=.env scripts/render.mjs"
  },
  "dependencies": {
    "@motion-canvas/2d": "3.17.2",
    "@motion-canvas/core": "3.17.2",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@motion-canvas/ffmpeg": "3.17.2",
    "@motion-canvas/ui": "3.17.2",
    "@motion-canvas/vite-plugin": "3.17.2",
    "@types/three": "0.186.0",
    "eventsource-parser": "4.1.1",
    "playwright-core": "1.64.0",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "zod": "4.6.5"
  }
}
