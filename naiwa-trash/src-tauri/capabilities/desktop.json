{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "本地奶蛙窗口和设置窗口",
  "windows": [
    "pet",
    "settings"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:event:default"
  ]
}
